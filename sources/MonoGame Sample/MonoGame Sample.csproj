<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <RootNamespace>Icy.MonoGameSample</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IcyUI.MonoGame\IcyUI.MonoGame.csproj" />
    <ProjectReference Include="..\IcyUI\IcyUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared Samples\ControlsDemo.cs" Link="Samples\ControlsDemo.cs" />
    <Compile Include="..\Shared Samples\StylesDemo.cs" Link="Samples\StylesDemo.cs" />
    <Compile Include="..\Shared Samples\MarkupDemo.cs" Link="Samples\MarkupDemo.cs" />
    <Compile Include="..\Shared Samples\NavigationDemo.cs" Link="Samples\NavigationDemo.cs" />
    <Compile Include="..\Shared Samples\MarkupStylesDemo.cs" Link="Samples\MarkupStylesDemo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\Fonts\Airfool.otf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Themes\AccentTheme.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Fonts\Inter-Italic-VariableFont_opsz,wght.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Fonts\My own test Arial font.fnt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Fonts\My own test Arial font_0.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
	<Message Text="Restoring dotnet tools" Importance="High" />
	<Exec Command="dotnet tool restore" />
  </Target>
</Project>
