<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Icy.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Animations\" />
    <Folder Include="Controls\" />
    <Folder Include="Extensions\" />
    <Folder Include="Helpers\" />
    <Folder Include="Input\" />
    <Folder Include="Parsing\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IcyUI\IcyUI.csproj" />
    <ProjectReference Include="..\IcyUI.Design\IcyUI.Design.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The samples' markup is the only place the loader is exercised against a full, realistic document.
         Linking the demo in means a document that stops parsing fails the test run rather than a sample launch. -->
    <Compile Include="..\Shared Samples\MarkupDemo.cs" Link="Markup\MarkupDemo.cs" />
    <Compile Include="..\Shared Samples\ControlTemplateDemo.cs" Link="Markup\ControlTemplateDemo.cs" />
    <Compile Include="..\Shared Samples\ScalingDemo.cs" Link="Samples\ScalingDemo.cs" />
    <Compile Include="..\Shared Samples\DesignDemo.cs" Link="Samples\DesignDemo.cs" />
    <Compile Include="..\Shared Samples\EditorDemo.cs" Link="Samples\EditorDemo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Airfool.otf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\comic10.fnt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\TestFont.fnt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\TestFont.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\TestPage.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\TestNonPageRoot.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\theme.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
