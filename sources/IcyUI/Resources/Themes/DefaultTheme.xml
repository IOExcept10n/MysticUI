<!-- Wrapped in a throwaway Border (never attached to anything - UseDefaultTheme discards it and keeps only
     its .Resources) rather than loaded as a bare <ResourceDictionary> document root: {StaticResource} resolves
     via the loader's UIElement ElementStack only, so a Style entry referencing a sibling ControlTemplate entry
     (Template="{StaticResource ...}") needs a real UIElement ancestor on that stack while its own Resources are
     being populated - a standalone ResourceDictionary document has none. -->
<Border>
  <Border.Resources>
  <!-- Button -->
  <ControlTemplate x:Key="IcyDefaultButtonTemplate" TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="Button" Template="{StaticResource IcyDefaultButtonTemplate}"
         Background="#FF3A3A44" BorderBrush="#FF56566A" BorderThickness="1" Padding="12,6">
    <Style.StateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Hovered" State="Hovered" Background="#FF46465A"/>
        <VisualState Name="Pressed" State="Pressed" Background="#FF2E2E38"/>
        <VisualState Name="Focused" State="Focused" BorderBrush="#FF3C78D8"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- ToggleButton -->
  <ControlTemplate x:Key="IcyDefaultToggleButtonTemplate" TargetType="ToggleButton">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="ToggleButton" Template="{StaticResource IcyDefaultToggleButtonTemplate}"
         Background="#FF3A3A44" BorderBrush="#FF56566A" BorderThickness="1" Padding="12,6">
    <Style.StateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Hovered" State="Hovered" Background="#FF46465A"/>
        <VisualState Name="Pressed" State="Pressed" Background="#FF2E2E38"/>
        <VisualState Name="Focused" State="Focused" BorderBrush="#FF3C78D8"/>
      </VisualStateGroup>
      <VisualStateGroup Name="CheckStates">
        <VisualState Name="Checked" State="Checked" Background="#FF3C78D8"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- CheckBox -->
  <ControlTemplate x:Key="IcyDefaultCheckBoxTemplate" TargetType="CheckBox">
    <StackPanel Orientation="Horizontal">
      <Border Width="16" Height="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="0,0,8,0">
        <Icon Kind="Checkmark" Stroke="{TemplateBinding CheckBrush}" StrokeThickness="2"/>
      </Border>
      <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
    </StackPanel>
  </ControlTemplate>

  <Style TargetType="CheckBox" Template="{StaticResource IcyDefaultCheckBoxTemplate}"
         Background="#FF3A3A44" BorderBrush="#FF56566A" BorderThickness="1" CheckBrush="Transparent">
    <Style.StateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Hovered" State="Hovered" BorderBrush="#FF6A6A80"/>
        <VisualState Name="Focused" State="Focused" BorderBrush="#FF3C78D8"/>
      </VisualStateGroup>
      <VisualStateGroup Name="CheckStates">
        <VisualState Name="Checked" State="Checked" Background="#FF3C78D8" CheckBrush="White"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- Slider -->
  <ControlTemplate x:Key="IcyDefaultSliderTemplate" TargetType="Slider">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <Border x:Name="PART_Thumb" Width="16" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{TemplateBinding ThumbBrush}"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="Slider" Template="{StaticResource IcyDefaultSliderTemplate}"
         Background="#FF3A3A44" BorderBrush="#FF56566A" BorderThickness="1" ThumbBrush="White">
    <Style.StateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Hovered" State="Hovered" ThumbBrush="#FFE0E0E0"/>
        <VisualState Name="Focused" State="Focused" BorderBrush="#FF3C78D8"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- ProgressBar -->
  <ControlTemplate x:Key="IcyDefaultProgressBarTemplate" TargetType="ProgressBar">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <Border x:Name="PART_Fill" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{TemplateBinding FillBrush}"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="ProgressBar" Template="{StaticResource IcyDefaultProgressBarTemplate}"
         Background="#FF3A3A44" BorderBrush="#FF56566A" BorderThickness="1" FillBrush="#FF3C78D8"/>

  <!-- SplitPane -->
  <ControlTemplate x:Key="IcyDefaultSplitPaneTemplate" TargetType="SplitPane">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <Border x:Name="PART_Divider" Background="{TemplateBinding DividerBrush}"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="SplitPane" Template="{StaticResource IcyDefaultSplitPaneTemplate}"
         Background="Transparent" BorderBrush="#FF56566A" BorderThickness="0" DividerBrush="#FF56566A">
    <Style.StateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Hovered" State="Hovered" DividerBrush="#FF6A6A80"/>
        <VisualState Name="Pressed" State="Pressed" DividerBrush="#FF3C78D8"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- ExpanderHeader -->
  <ControlTemplate x:Key="IcyDefaultExpanderHeaderTemplate" TargetType="ExpanderHeader">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <StackPanel Orientation="Horizontal">
        <Icon Kind="ChevronRight" Stroke="White" StrokeThickness="2" RenderRotation="{TemplateBinding ChevronRotation}" Margin="0,0,8,0"/>
        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </ControlTemplate>

  <Style TargetType="ExpanderHeader" Template="{StaticResource IcyDefaultExpanderHeaderTemplate}"
         Background="Transparent" BorderBrush="#FF56566A" BorderThickness="0" Padding="8,6" ChevronRotation="0">
    <Style.StateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Hovered" State="Hovered" Background="#FF33333E"/>
        <VisualState Name="Pressed" State="Pressed" Background="#FF2E2E38"/>
        <VisualState Name="Focused" State="Focused" BorderBrush="#FF3C78D8" BorderThickness="1"/>
      </VisualStateGroup>
      <VisualStateGroup Name="CheckStates">
        <VisualState Name="Checked" State="Checked" ChevronRotation="90"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- Expander -->
  <ControlTemplate x:Key="IcyDefaultExpanderTemplate" TargetType="Expander">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <ExpanderHeader x:Name="PART_Header"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="Expander" Template="{StaticResource IcyDefaultExpanderTemplate}"
         Background="#FF26262C" BorderBrush="#FF3A3A44" BorderThickness="1">
    <Style.StateGroups>
      <VisualStateGroup Name="ExpansionStates">
        <VisualState Name="Expanded" State="Expanded" ExpansionProgress="1" Duration="0:0:0.2" Easing="EaseOutCubic"/>
        <VisualState Name="Collapsed" State="Normal" ExpansionProgress="0" Duration="0:0:0.2" Easing="EaseOutCubic"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- SelectorItem -->
  <Style TargetType="SelectorItem" Background="Transparent" Padding="8,6">
    <Style.StateGroups>
      <!-- One shared group, not "Hovered" split off into its own group as before - every VisualState here sets
           Background, and UIElement's VisualState-tier property storage is one flat slot per property shared
           across every group on the element, not isolated per group. Two groups both touching Background meant
           leaving the item (clearing the "Hovered" group's own state) cleared that shared slot outright, wiping
           out "Selected"/"Highlighted"'s Background even though its own group's active state never changed -
           SelectorItem's selection highlight visibly vanished the moment the pointer moved off a selected item.
           Explicit Selected+Hovered/Highlighted+Hovered compound states (bit count 2, so ApplyBestMatchingState's
           "largest subset wins" rule always prefers them over plain "Hovered" alone, bit count 1) keep the
           selection color showing through hover instead of losing to whichever state a tie would pick. -->
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Hovered" State="Hovered" Background="#FF33333E"/>
        <VisualState Name="Selected" State="Selected" Background="#FF3C78D8"/>
        <VisualState Name="SelectedHovered" State="Selected,Hovered" Background="#FF3C78D8"/>
        <VisualState Name="Highlighted" State="Highlighted" Background="#FF46465A"/>
        <VisualState Name="HighlightedHovered" State="Highlighted,Hovered" Background="#FF46465A"/>
        <VisualState Name="Disabled" State="Disabled" Opacity="0.5"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- Dropdown -->
  <ControlTemplate x:Key="IcyDefaultDropdownTemplate" TargetType="Dropdown">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ToggleButton x:Name="PART_ToggleButton"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="Dropdown" Template="{StaticResource IcyDefaultDropdownTemplate}"
         Background="#FF2E2E38" BorderBrush="#FF56566A" BorderThickness="1" Padding="8,6"
         PopupBackground="#FF2E2E38" PopupBorderBrush="#FF56566A" PopupBorderThickness="1">
    <Style.StateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Hovered" State="Hovered" BorderBrush="#FF6A6A80"/>
        <VisualState Name="Focused" State="Focused" BorderBrush="#FF3C78D8"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- ComboBox -->
  <Style TargetType="ComboBox" Background="#FF2E2E38" BorderBrush="#FF56566A" BorderThickness="1" Padding="8,6"
         PopupBackground="#FF2E2E38" PopupBorderBrush="#FF56566A" PopupBorderThickness="1">
    <Style.StateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Hovered" State="Hovered" BorderBrush="#FF6A6A80"/>
        <VisualState Name="Focused" State="Focused" BorderBrush="#FF3C78D8"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <!-- TextBox, ScrollViewer, Window: Style-only (Border-level decoration through Control's existing dual-path
       forwarding) - neither is template-safe yet (see Control.Template's own remarks), so no ControlTemplate is
       applied to them here; a future named-template-parts retrofit can add one without touching these entries. -->
  <Style TargetType="TextBox" Background="#FF2E2E38" BorderBrush="#FF56566A" BorderThickness="1" Padding="6,4">
    <Style.StateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Focused" State="Focused" BorderBrush="#FF3C78D8"/>
      </VisualStateGroup>
    </Style.StateGroups>
  </Style>

  <Style TargetType="ScrollViewer" Background="Transparent" BorderBrush="#FF56566A" BorderThickness="0"/>

  <Style TargetType="Window" Background="#FF26262C" BorderBrush="#FF56566A" BorderThickness="1"/>

  <!-- TabControl: untemplated, like TextBox/ScrollViewer/Window above - plain Border-level decoration is all
       this control needs (its header row/content are managed directly, not via Chrome). -->
  <Style TargetType="TabControl" Background="#FF26262C" BorderBrush="#FF56566A" BorderThickness="1"/>

  <!-- Dialog -->
  <ControlTemplate x:Key="IcyDefaultDialogTemplate" TargetType="Dialog">
    <Border Background="#AA000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Background="#FF2E2E38" BorderBrush="#FF56566A" BorderThickness="1" Padding="16"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentPresenter Content="{TemplateBinding Content}"/>
      </Border>
    </Border>
  </ControlTemplate>

  <Style TargetType="Dialog" Template="{StaticResource IcyDefaultDialogTemplate}"/>
  </Border.Resources>
</Border>
